# Compose reads this file; local backend also reads .env in backend/.
APP_ENV=development
JWT_SECRET=development-only-change-this-secret-before-deployment
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
POSTGRES_PASSWORD=development-db-password
DATABASE_URL=postgresql+psycopg://workbench:development-db-password@db:5432/workbench
REDIS_URL=redis://redis:6379/0
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Workbench <noreply@workbench.local>
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# hashing needs no model download. For semantic vectors install .[semantic], set mode,
# and reindex existing documents; embeddings from different modes cannot be mixed.
EMBEDDING_MODE=hashing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ENABLE_LOCAL_MODEL=false
LOCAL_MODEL_URL=http://host.docker.internal:8080/v1
LOCAL_MODEL_NAME=local
EAGER_JOBS=false
MAX_DOCUMENTS=50
MAX_CHUNKS=5000
MAX_RUNS_PER_DAY=100
ARTIFACT_DIR=/data/artifacts
